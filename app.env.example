# 复制为 app.env 后填写。app.env 含密钥，不要提交到仓库。

# ---- 构建用 ----
# Linux 版 camoufox 的 tar.gz 直链。到 https://github.com/daijro/camoufox/releases
# 找 linux x86_64 的那个资源，复制直链填进来。只在 docker compose build 时需要。
CAMOUFOX_URL=

# ---- 必填 ----

# 客户端调用用的密码，自己生成一个随机串。多个用逗号分隔。
# 不设的话默认是 build，公网暴露等于把你的账号额度开放给所有人。
# 生成：openssl rand -hex 16
API_KEYS=

# 你自己 Remix 并设为 Public 的 Build app 链接
TARGET_URL=https://ai.studio/apps/你的-app-uuid

# ---- 凭证（方式 B：环境变量）----
# 用 docker-compose 的 ./auth 挂载时，这几行保持注释。
# 填的话是 single-line-auth/auth-single-N.json 的全部内容（单行那份）。
# AUTH_JSON_1=
# AUTH_JSON_2=

# ---- 选填 ----

# 监听地址与端口。容器内要监听 0.0.0.0 才能被映射出去。
HOST=0.0.0.0
PORT=7860

# 用满多少次后主动切下一个账号。按每模型每日 100 次额度，单号建议 90-100。
SWITCH_ON_USES=100

# 连续失败多少次后切换账号
FAILURE_THRESHOLD=3

# 收到这些状态码立刻切换账号
IMMEDIATE_SWITCH_STATUS_CODES=429,503

# 单次请求最大重试次数。浏览器端已有 3 次重试，这里设 1 即可。
MAX_RETRIES=1

# 重试间隔（毫秒）
RETRY_DELAY=2000

# 流模式：real 走流式接口（审查更严），fake 走非流接口（审查更少）
STREAMING_MODE=real

# 起始账号编号，留空为第一个
# INITIAL_AUTH_INDEX=

# 面板设置与凭证状态的存放目录。docker-compose 已设为 /app/data，一般不用改。
STATE_DIR=/app/data
